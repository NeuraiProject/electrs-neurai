# Configuration of the testnet stack (Neurai DePIN-Test node + electrs-neurai).
#
#   cp .env.example .env     # then edit .env (it is not committed)
#   docker compose up -d --build
#
# The default ports differ from the mainnet stack, so both can run on one host.

# ── Node RPC credentials (used by the node and by electrs) ───────────────────
NEURAI_RPC_USER=neurai
# Required. A long random string, e.g. the output of `openssl rand -hex 32`.
NEURAI_RPC_PASSWORD=

# ── Domain and TLS certificate ───────────────────────────────────────────────
# Empty: electrs uses a self-signed certificate (electrum-neurai accepts it on
# first use, browsers do not).
# With a domain managed by Cloudflare, the letsencrypt service gets a free
# Let's Encrypt certificate for it through the Cloudflare API (DNS-01: a TXT
# record, no port needs to be open on this server), and renews it:
#   * DOMAIN must be in a zone of the Cloudflare account; the service checks it
#     with the token before asking Let's Encrypt;
#   * its A record (and AAAA, if any) must point to this server and be
#     "DNS only" (grey cloud): ssl:// cannot go through Cloudflare's proxy.
# Use another name than the mainnet stack's, e.g. testnet.electrum.example.org.
DOMAIN=
# Cloudflare API token: dash.cloudflare.com → My Profile → API Tokens → Create
# Token → template "Edit zone DNS" → Zone Resources: Include, Specific zone, the
# zone of DOMAIN. It can only edit that zone's DNS. Keep this file private.
CLOUDFLARE_API_TOKEN=
# Seconds to wait for the TXT record to be visible before Let's Encrypt checks it.
CLOUDFLARE_PROPAGATION_SECONDS=30
# Optional e-mail for the Let's Encrypt account.
LETSENCRYPT_EMAIL=
# 1 = Let's Encrypt staging (untrusted certificates, to test the setup without
# hitting the rate limits). Back to 0 for the real certificate.
LETSENCRYPT_STAGING=0

# ── Ports published on this host ─────────────────────────────────────────────
ELECTRUM_TCP_PORT=60001
ELECTRUM_SSL_PORT=60002
ELECTRUM_WSS_PORT=60004
# Empty: a free port chosen by Docker.
NODE_P2P_PORT=19100
# Published on 127.0.0.1 only. Empty: a free port chosen by Docker.
NODE_RPC_PORT=19101

# ── Several stacks on one host ───────────────────────────────────────────────
# Each stack (a copy of this directory) has its own containers
# (<name>-node, <name>-electrs, <name>-letsencrypt), volumes and network. <name>
# is the directory's name (e.g. "testnet"), or this. Changing it on an existing
# installation starts with new, empty volumes: the node syncs again.
#COMPOSE_PROJECT_NAME=neurai-testnet-b
#
# Stacks on one host also need their own ports above, or their own address.
#
# Electrum ports: published on every address of this host (IPv4 and IPv6),
# or only on this one, e.g. 203.0.113.5, [2001:db8::5] or 127.0.0.1.
ELECTRUM_LISTEN=
# Node P2P port: published on 127.0.0.1 only, so other nodes can't connect in
# (the node still connects out to its peers, and electrs reaches it inside
# the stack). 0.0.0.0, or a public address of this host, lets other nodes
# connect in and helps the network. Note that Docker's published ports are
# not filtered by the host's firewall (ufw).
NODE_P2P_LISTEN=127.0.0.1

# ── electrs options (empty = electrs default) ────────────────────────────────
ELECTRS_LOG_FILTERS=INFO
ELECTRS_SERVER_BANNER=
ELECTRS_DONATION_ADDRESS=
# What server.features reports, e.g. ssl://testnet.electrum.example.org:60002
# Default: tcp, ssl and wss on DOMAIN with the ports above (or the listening addresses without DOMAIN).
ELECTRS_REPORT_SERVICES=

# ── Neurai node (built from source; neurai.conf is rewritten on every start) ─
NEURAI_BRANCH=DePIN-Test
# electrs does not need these indexes; they are for other users of the node.
# Turning txindex, addressindex, timestampindex, spentindex or pubkeyindex on
# after the first sync needs a -reindex of the node.
NEURAI_TXINDEX=1
NEURAI_ASSETINDEX=1
NEURAI_ADDRESSINDEX=1
NEURAI_TIMESTAMPINDEX=1
NEURAI_SPENTINDEX=1
# Revealed public keys; required by DePIN messaging and getpubkey.
NEURAI_PUBKEYINDEX=1
# NIP-047 silent payment tweaks for light clients (getsilentpaymenttweaks, REST).
# Built at startup when turned on later, no reindex.
NEURAI_SILENTPAYMENTINDEX=1
# NIP-048 messages of owner and message channel tokens (getchannelmessages,
# REST). Built at startup when turned on later, no reindex.
NEURAI_CHANNELMESSAGEINDEX=1
