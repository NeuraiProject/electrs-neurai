# Configuration of the testnet stack (Neurai DePIN-Test node + electrs-neurai).
#
#   cp .env.example .env     # then edit .env (it is not committed)
#   docker compose up -d --build
#
# The default ports differ from the mainnet stack, so both can run on one host.

# ── Node RPC credentials (used by the node and by electrs) ───────────────────
NEURAI_RPC_USER=neurai
# Required. A long random string, e.g. the output of `openssl rand -hex 32`.
NEURAI_RPC_PASSWORD=

# ── Domain and TLS certificate ───────────────────────────────────────────────
# Empty: electrs uses a self-signed certificate (electrum-neurai accepts it on
# first use, browsers do not).
# With a domain, the letsencrypt service gets a free Let's Encrypt certificate
# for it by proving control of the domain (HTTP-01), and renews it:
#   * the domain's A record (and AAAA, if any) must point to this server. On
#     Cloudflare, set it to "DNS only" (grey cloud): ssl:// cannot go through
#     Cloudflare's proxy;
#   * port 80 of this server must be reachable from the internet. certbot only
#     listens on it for the few seconds of each validation.
# Use another name than the mainnet stack's, e.g. testnet.electrum.example.org.
DOMAIN=
# Optional e-mail for the Let's Encrypt account.
LETSENCRYPT_EMAIL=
# 1 = Let's Encrypt staging (untrusted certificates, to test the setup without
# hitting the rate limits). Back to 0 for the real certificate.
LETSENCRYPT_STAGING=0
# Port certbot listens on for the validation: 80, unless a proxy forwards
# /.well-known/acme-challenge/ from port 80 to another port.
ACME_HTTP_PORT=80

# ── Ports published on this host ─────────────────────────────────────────────
ELECTRUM_TCP_PORT=60001
ELECTRUM_SSL_PORT=60002
ELECTRUM_WSS_PORT=60004
NODE_P2P_PORT=19100
# Published on 127.0.0.1 only.
NODE_RPC_PORT=19101

# ── electrs options (empty = electrs default) ────────────────────────────────
ELECTRS_LOG_FILTERS=INFO
ELECTRS_SERVER_BANNER=
ELECTRS_DONATION_ADDRESS=
# What server.features reports, e.g. ssl://testnet.electrum.example.org:60002
# Default: tcp, ssl and wss on DOMAIN with the ports above (or the listening addresses without DOMAIN).
ELECTRS_REPORT_SERVICES=

# ── Neurai node (built from source; neurai.conf is rewritten on every start) ─
NEURAI_BRANCH=DePIN-Test
# electrs does not need these indexes; they are for other users of the node.
# Turning txindex, addressindex, timestampindex, spentindex or pubkeyindex on
# after the first sync needs a -reindex of the node.
NEURAI_TXINDEX=1
NEURAI_ASSETINDEX=1
NEURAI_ADDRESSINDEX=1
NEURAI_TIMESTAMPINDEX=1
NEURAI_SPENTINDEX=1
# Revealed public keys; required by DePIN messaging and getpubkey.
NEURAI_PUBKEYINDEX=1
# NIP-047 silent payment tweaks for light clients (getsilentpaymenttweaks, REST).
# Built at startup when turned on later, no reindex.
NEURAI_SILENTPAYMENTINDEX=1
# NIP-048 messages of owner and message channel tokens (getchannelmessages,
# REST). Built at startup when turned on later, no reindex.
NEURAI_CHANNELMESSAGEINDEX=1
